{
  "name": "sky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sky — capability-OS preview (Node headless core + Web Shell)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:auth && npm run test:edit",
    "test:auth": "node scripts/auth-e2e.mjs",
    "test:edit": "node scripts/edit-e2e.mjs",
    "test:ai-edit": "node scripts/edit-ai-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "ws": "^8.22.0"
  }
}
